# Copy this file to backend/.env and replace placeholders with your real values.
# Never commit .env (it contains secrets).
#
# Where to get DATABASE_URL:
#   1. Open https://supabase.com/dashboard
#   2. Select the CarbonLens project
#   3. Project Settings -> Database
#   4. Copy the URI connection string (use Session pooler or Direct connection)
#   5. Paste it below. postgresql:// is rewritten to postgresql+psycopg2://
#      and sslmode=require is added for supabase hosts if missing.

DATABASE_URL=

# Browser origins allowed to call the API from a separate frontend.
# For local frontend development this typically includes common Vite/React ports.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173

# Optional
APP_NAME=CarbonLens API
DB_ECHO=false
GEMINI_API_KEY=your_gemini_api_key_here
